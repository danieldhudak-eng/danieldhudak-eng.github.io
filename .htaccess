# MEDIfogg web · Apache (Websupport)
# Statický Astro build (build.format = "file": /problem → /problem.html).

Options -MultiViews -Indexes
# /en a /de sú súbory en.html, de.html aj priečinky: mod_dir by /en presmeroval na /en/ (slučka). Lomku pri priečinkoch rieši rewrite nižšie.
DirectorySlash Off
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Produkcia (11. 10. 2026): hlavná doména https://www.medifogg.com, ostatné domény klienta 301 na ňu.
  # Platí len pre vymenované hosty, dev (medifogg.opusmagnus.co) a localhost sa netýka.
  RewriteCond %{HTTP_HOST} ^(medifogg\.com|(www\.)?detectair\.sk|(www\.)?detectair\.eu|(www\.)?hydrofogg\.eu|(www\.)?hydrofogg\.sk|(www\.)?detectairtechnologies\.com)$ [NC]
  RewriteRule ^ https://www.medifogg.com%{REQUEST_URI} [R=301,L]

  # HTTPS (Websupport má Let's Encrypt; ak certifikát ešte nie je aktívny, tento blok dočasne zakomentovať)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # /stranka.html → /stranka (kanonické čisté URL)
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /index → /
  RewriteRule ^index/?$ / [R=301,L]

  # Jazykové domovské stránky (14. 10. 2026): /en a /de sú zároveň priečinky podstránok, súbor je en.html / de.html
  # (/en/ bez presmerovania, aby nevznikla slučka, ak by hosting DirectorySlash Off ignoroval; kanonická URL je /en)
  RewriteRule ^(en|de)/?$ $1.html [L]
  # Ostatné priečinky (/dopyty, /admin …) → s lomkou, aby sa načítal index
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

  # Odstrániť koncovú lomku (okrem koreňa)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /stranka → /stranka.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# MIME typy (staršie Apache nemusia poznať avif/woff2)
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  # Hashované assety Astro → rok, immutable
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Ostatné statické súbory → týždeň
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # HTML → vždy revalidovať
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml font/woff2
</IfModule>
